# Copy to server/.env and adjust. Never commit a real .env (§6.5).

# Matches server/docker-compose.yml.
DATABASE_URL=postgres://glidewood:glidewood@localhost:5432/glidewood

PORT=8787
HOST=0.0.0.0

# Must match the seed the client generates its forest from, or the server will
# not recognise the caches players are collecting.
WORLD_SEED=glidewood-phase-1

# Browser origin(s) allowed to call the API. '*' is fine locally.
CORS_ORIGINS=http://localhost:5173

# Anti-cheat tolerances (§6.3). Raise only with a reason — graceSeconds is
# multiplied by top speed, so each second buys the client ~38 metres.
VALIDATION_GRACE_SECONDS=3
VALIDATION_GRACE_METRES=25
VALIDATION_CLAIM_RADIUS=30
VALIDATION_SPEED_TOLERANCE=1.6

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ECONOMY_MAX=120
