{
  "name": "glidewood",
  "private": true,
  "version": "0.1.0",
  "description": "Glidewood — a browser-based gliding squirrel exploration game. Phase 1: prove the glide.",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^16.5.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
